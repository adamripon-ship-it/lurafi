{%- comment -%}
  Video showcase — immersive, full-bleed stage under the hero.

  Behaviour (progressive, no framework):
  - Poster frame + a large custom play button; the raw <video> has no browser
    chrome until the viewer starts it.
  - Silent preview: a ~5 s muted, text-free loop (assets/kevin-video-teaser.mp4)
    plays over the poster once the stage scrolls near the viewport. Skipped for
    prefers-reduced-motion and Save-Data; paused off-screen; a small corner
    button pauses/resumes it (WCAG 2.2.2). Only used with the bundled film.
  - Desktop: clicking plays inline in the full-width stage (native controls
    appear; the native fullscreen button is available from there).
  - Mobile: tapping opens the phone's native fullscreen landscape player
    (requestFullscreen / iOS webkitEnterFullscreen) — a real viewing
    experience instead of a cramped inline letterbox. The inline mobile stage
    is a tall portrait poster card so it never looks like a shrunken banner.
  - End card: when the film finishes, a "Configure & buy" CTA and a replay
    button sit over the poster instead of silently resetting (keyboard focus
    moves to the CTA).
  - Analytics: publishes Shopify custom events (kevin_video_start,
    kevin_video_progress 25/50/75, kevin_video_complete, kevin_video_cta_click;
    replays send kevin_video_start with replay: true). A custom pixel forwards them to GA4 — see
    docs/VIDEO-ANALYTICS.md.
  - SEO: VideoObject JSON-LD for the bundled film.

  Source: bundled assets/kevin-video-showcase.mp4 by default; a Shopify-hosted
  "video" setting overrides it (its sources are used directly so the custom UI
  stays consistent).
{%- endcomment -%}
{%- liquid
  assign overline = section.settings.overline
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign caption = section.settings.caption
  assign play_label = section.settings.play_label | strip
  if play_label == blank
    assign play_label = 'video_showcase.play_label' | t
  endif

  assign has_shopify_video = false
  if section.settings.video != blank and section.settings.video.sources.size > 0
    assign has_shopify_video = true
  endif

  # Bundled film length (assets/kevin-video-showcase.mp4) — update with the file.
  assign duration_s = 43
  if has_shopify_video and section.settings.video.duration > 0
    assign duration_s = section.settings.video.duration | divided_by: 1000 | floor
  endif
  assign duration_min = duration_s | divided_by: 60 | floor
  assign duration_sec = duration_s | modulo: 60
  assign duration_label = duration_sec | prepend: '0' | slice: -2, 2 | prepend: ':' | prepend: duration_min

  assign show_teaser = false
  if section.settings.show_teaser and has_shopify_video == false
    assign show_teaser = true
  endif

  assign poster_url = ''
  if section.settings.poster != blank
    assign poster_url = section.settings.poster | image_url: width: 1920
  else
    assign poster_url = 'kevin-video-showcase-poster.webp' | asset_url
  endif
  assign poster_alt = caption
  if poster_alt == blank
    assign poster_alt = heading
  endif
  if poster_alt == blank
    assign poster_alt = 'video_showcase.poster_alt' | t
  endif
  assign poster_alt = poster_alt | replace: '&amp;', '&' | replace: '&#39;', "'" | replace: '&#x27;', "'" | replace: '&quot;', '"' | replace: '&#34;', '"'

  capture configure_buy_url
    render 'configure-url', plan: 'buy'
  endcapture
  assign configure_buy_url = configure_buy_url | strip
  assign cta_label = 'home.hero.cta_primary_label' | t
-%}

<section class="section-apple lp-video" data-lp-video>
  {%- if overline != blank or heading != blank or subheading != blank -%}
    <div class="apple-container lp-video__intro">
      {% render 'section-intro',
        overline: overline,
        heading: heading,
        subheading: subheading,
        theme: 'dark'
      %}
    </div>
  {%- endif -%}

  <div class="lp-video__stage">
    {%- comment -%}
      Fast-loading WebP poster as a real <img> (SEO alt + no CLS). The film
      itself uses preload="none", so none of the multi-MB file is fetched until
      the viewer taps play — big mobile/LCP win. The poster hides on .is-playing.
    {%- endcomment -%}
    <img
      class="lp-video__poster"
      src="{{ poster_url }}"
      alt="{{ poster_alt | escape }}"
      loading="lazy"
      decoding="async"
      width="1600"
      height="900"
    >
    {%- if show_teaser -%}
      {%- comment -%} src is set by JS when the stage nears the viewport (~0.7 MB). {%- endcomment -%}
      <video
        class="lp-video__teaser"
        muted
        playsinline
        loop
        preload="none"
        aria-hidden="true"
        tabindex="-1"
        disablepictureinpicture
        data-lp-video-teaser
        data-src="{{ 'kevin-video-teaser.mp4' | asset_url }}"
      ></video>
    {%- endif -%}
    <video
      id="LpVideo-{{ section.id }}"
      class="lp-video__player"
      playsinline
      preload="none"
      {%- if poster_url != blank %} poster="{{ poster_url }}"{% endif %}
    >
      {%- if has_shopify_video -%}
        {%- for source in section.settings.video.sources -%}
          <source src="{{ source.url }}" type="{{ source.mime_type }}">
        {%- endfor -%}
      {%- else -%}
        <source src="{{ 'kevin-video-showcase.mp4' | asset_url }}" type="video/mp4">
      {%- endif -%}
    </video>

    <div class="lp-video__overlay" data-lp-video-overlay>
      <button
        type="button"
        class="lp-video__play"
        aria-label="{{ play_label | escape }} ({{ duration_label }})"
        data-lp-video-play
      >
        <span class="lp-video__play-icon" aria-hidden="true"></span>
      </button>
      <span class="lp-video__play-label" aria-hidden="true">
        {{- play_label | escape -}}
        <span class="lp-video__play-duration">{{ duration_label }}</span>
      </span>
    </div>

    {%- if show_teaser -%}
      <button
        type="button"
        class="lp-video__teaser-toggle"
        aria-label="{{ 'video_showcase.pause_preview' | t | escape }}"
        data-label-pause="{{ 'video_showcase.pause_preview' | t | escape }}"
        data-label-play="{{ 'video_showcase.play_preview' | t | escape }}"
        data-lp-video-teaser-toggle
        hidden
      >
        <span class="lp-video__teaser-icon" aria-hidden="true"></span>
      </button>
    {%- endif -%}

    <div class="lp-video__end" data-lp-video-end hidden>
      <a href="{{ configure_buy_url }}" class="btn-apple-primary lp-video__end-cta" data-lp-video-cta>
        {{- cta_label | escape -}}
      </a>
      <button type="button" class="lp-video__replay" data-lp-video-replay>
        <span class="lp-video__replay-icon" aria-hidden="true">&#8635;</span>
        {{ 'video_showcase.replay' | t | escape }}
      </button>
    </div>
  </div>

  {%- if caption != blank -%}
    <div class="apple-container">
      <p class="lp-video__caption body-reduced text-muted">{{ caption | escape }}</p>
    </div>
  {%- endif -%}
</section>

{%- unless has_shopify_video -%}
  {%- liquid
    assign video_name = 'video_showcase.seo_name' | t
    assign video_description = 'video_showcase.seo_description' | t
    assign video_content_url = 'kevin-video-showcase.mp4' | asset_url | prepend: 'https:'
    assign video_thumb_url = poster_url
    unless video_thumb_url contains 'https:'
      assign video_thumb_url = video_thumb_url | prepend: 'https:'
    endunless
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "VideoObject",
      "name": {{ video_name | json }},
      "description": {{ video_description | json }},
      "thumbnailUrl": [{{ video_thumb_url | json }}],
      "uploadDate": "2026-10-17T00:00:00+02:00",
      "duration": "PT{{ duration_s }}S",
      "contentUrl": {{ video_content_url | json }},
      "publisher": {
        "@type": "Organization",
        "name": {{ shop.name | json }}
      }
    }
  </script>
{%- endunless -%}

<script>
  (function () {
    var video = document.getElementById('LpVideo-{{ section.id }}');
    if (!video) return;
    var stage = video.closest('.lp-video__stage');
    var overlay = stage && stage.querySelector('[data-lp-video-overlay]');
    var btn = stage && stage.querySelector('[data-lp-video-play]');
    if (!stage || !overlay || !btn) return;
    var endCard = stage.querySelector('[data-lp-video-end]');
    var replayBtn = stage.querySelector('[data-lp-video-replay]');
    var ctaLink = stage.querySelector('[data-lp-video-cta]');
    var teaser = stage.querySelector('[data-lp-video-teaser]');
    var teaserToggle = stage.querySelector('[data-lp-video-teaser-toggle]');

    var mobileQuery = window.matchMedia('(max-width: 749px), (pointer: coarse)');
    var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    var FALLBACK_DURATION = {{ duration_s }};

    /* ---- Analytics: Shopify custom events (forwarded to GA4 by a custom pixel) ---- */
    var sentMilestones = {};
    var isReplay = false;
    function track(name, extra) {
      var data = {
        video_title: 'KEVIN brand film',
        video_duration: Math.round(video.duration) || FALLBACK_DURATION,
        video_current_time: Math.round(video.currentTime || 0),
        locale: document.documentElement.lang || '',
        replay: isReplay
      };
      if (extra) for (var k in extra) data[k] = extra[k];
      try {
        if (window.Shopify && Shopify.analytics && typeof Shopify.analytics.publish === 'function') {
          Shopify.analytics.publish(name, data);
        }
      } catch (e) {}
      try {
        if (Array.isArray(window.dataLayer)) window.dataLayer.push(Object.assign({ event: name }, data));
      } catch (e) {}
    }

    /* ---- Silent preview loop ---- */
    var teaserUserPaused = false;
    var teaserInView = false;
    function teaserAllowed() {
      if (!teaser || reducedMotion.matches) return false;
      var conn = navigator.connection;
      return !(conn && conn.saveData);
    }
    function setToggleState(paused) {
      if (!teaserToggle) return;
      teaserToggle.classList.toggle('is-paused', paused);
      teaserToggle.setAttribute('aria-label', paused ? teaserToggle.dataset.labelPlay : teaserToggle.dataset.labelPause);
    }
    function playTeaser() {
      if (!teaser || teaserUserPaused || !teaserInView || stage.classList.contains('is-playing') || stage.classList.contains('is-ended')) return;
      if (!teaser.src) teaser.src = teaser.dataset.src;
      var p = teaser.play();
      if (p && p.catch) p.catch(function () {});
    }
    function pauseTeaser() {
      if (teaser && !teaser.paused) teaser.pause();
    }
    if (teaserAllowed()) {
      teaser.addEventListener('playing', function () {
        stage.classList.add('has-teaser');
        if (teaserToggle) teaserToggle.hidden = false;
      });
      if (teaserToggle) {
        teaserToggle.addEventListener('click', function () {
          teaserUserPaused = !teaserUserPaused;
          setToggleState(teaserUserPaused);
          if (teaserUserPaused) pauseTeaser(); else playTeaser();
        });
      }
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
          teaserInView = entries[entries.length - 1].isIntersecting;
          if (teaserInView) playTeaser(); else pauseTeaser();
        }, { rootMargin: '200px 0px' }).observe(stage);
      }
    } else if (teaser) {
      teaser.remove();
      teaser = null;
      if (teaserToggle) teaserToggle.remove();
      teaserToggle = null;
    }

    /* ---- Full film ---- */
    function requestFs(el) {
      var fn = el.requestFullscreen || el.webkitRequestFullscreen || el.webkitEnterFullscreen || el.msRequestFullscreen;
      if (!fn) return;
      try {
        var r = fn.call(el);
        if (r && r.catch) r.catch(function () {});
      } catch (e) {}
    }

    function exitFs() {
      try {
        if (document.fullscreenElement && document.exitFullscreen) {
          var r = document.exitFullscreen();
          if (r && r.catch) r.catch(function () {});
        } else if (video.webkitDisplayingFullscreen && video.webkitExitFullscreen) {
          video.webkitExitFullscreen();
        }
      } catch (e) {}
    }

    // iOS only enters native fullscreen once the film's metadata is loaded, and
    // only inside the tap. On phones, fetch just the metadata (moov atom, a few
    // KB thanks to faststart) when the stage nears the viewport so the first tap
    // can go fullscreen immediately.
    if (mobileQuery.matches && 'IntersectionObserver' in window) {
      var metaObserver = new IntersectionObserver(function (entries) {
        if (!entries[entries.length - 1].isIntersecting) return;
        metaObserver.disconnect();
        if (video.preload === 'none' && video.readyState === 0) {
          video.preload = 'metadata';
          try { video.load(); } catch (e) {}
        }
      }, { rootMargin: '300px 0px' });
      metaObserver.observe(stage);
    }

    function start() {
      pauseTeaser();
      stage.classList.remove('is-ended');
      if (endCard) endCard.hidden = true;
      stage.classList.add('is-playing');
      video.controls = true;
      sentMilestones = {};
      if (mobileQuery.matches) {
        if (video.readyState >= 1) requestFs(video);
        else video.addEventListener('loadedmetadata', function () { requestFs(video); }, { once: true });
      }
      var p = video.play();
      if (p && p.catch) p.catch(function () {});
      track('kevin_video_start');
    }

    function reset() {
      stage.classList.remove('is-playing');
      video.controls = false;
      playTeaser();
    }

    function showEndCard() {
      exitFs();
      stage.classList.remove('is-playing');
      stage.classList.add('is-ended');
      video.controls = false;
      var focusWasInStage = stage.contains(document.activeElement);
      if (endCard) endCard.hidden = false;
      if (focusWasInStage && ctaLink) ctaLink.focus({ preventScroll: true });
      track('kevin_video_complete');
    }

    btn.addEventListener('click', start);
    overlay.addEventListener('click', function (e) {
      if (e.target === overlay) start();
    });

    video.addEventListener('timeupdate', function () {
      var d = video.duration;
      if (!d || !isFinite(d)) return;
      var pct = (video.currentTime / d) * 100;
      [25, 50, 75].forEach(function (m) {
        if (pct >= m && !sentMilestones[m]) {
          sentMilestones[m] = true;
          track('kevin_video_progress', { video_percent: m });
        }
      });
    });

    video.addEventListener('ended', showEndCard);
    video.addEventListener('pause', function () {
      // If paused back at the very start (e.g. after exiting fullscreen), restore the poster overlay.
      if (video.currentTime === 0 && !stage.classList.contains('is-ended')) reset();
    });

    if (replayBtn) {
      replayBtn.addEventListener('click', function () {
        isReplay = true;
        try { video.currentTime = 0; } catch (e) {}
        start();
        try { video.focus({ preventScroll: true }); } catch (e) {}
      });
    }

    if (ctaLink) {
      ctaLink.addEventListener('click', function () {
        track('kevin_video_cta_click', { link_url: ctaLink.href });
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Video showcase",
  "settings": [
    {
      "type": "paragraph",
      "content": "Full-width video with a custom play button. Plays inline on desktop and opens fullscreen on mobile. A buy button and replay appear when the film ends. Heading fields are optional."
    },
    { "type": "text", "id": "overline", "label": "Overline" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (override)",
      "info": "Optional. Select a video to replace the built-in one — Shopify hosts and streams it. Leave blank to use the bundled default video."
    },
    {
      "type": "checkbox",
      "id": "show_teaser",
      "label": "Show silent preview loop",
      "info": "Plays a short muted preview over the poster. Only used with the bundled video.",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Poster image",
      "info": "Recommended. Shown before playback (a wide landscape image works best). Without one, the video's first frame is used."
    },
    {
      "type": "text",
      "id": "play_label",
      "label": "Play button label",
      "info": "Leave blank to use the translated default (\"Watch the film\")."
    },
    { "type": "text", "id": "caption", "label": "Caption (optional)" }
  ],
  "presets": [
    {
      "name": "Video showcase"
    }
  ]
}
{% endschema %}
