{%- liquid
  capture configure_url
    render 'configure-url', plan: 'buy'
  endcapture
  assign configure_url = configure_url | strip
  assign edit_separator = '?'
  if configure_url contains '?'
    assign edit_separator = '&'
  endif
-%}

<section class="cart-page" data-cart-section="{{ section.id }}">
  <div class="apple-container">
    <h1 class="headline-section cart-page__title">{{ 'sections.cart.title' | t }}</h1>

    {%- if cart.item_count > 0 -%}
      <p class="cart-page__edit">
        <a href="{{ configure_url }}{{ edit_separator }}edit=1" class="link-apple-blue">{{ 'cart.edit_configuration' | t }}</a>
      </p>

      {% form 'cart', cart, id: 'CartForm', class: 'cart-form' %}
        <div class="cart-page__items">
          {%- for item in cart.items -%}
            <div class="cart-line" data-cart-line data-line="{{ forloop.index }}">
              <div class="cart-line__image">
                {%- if item.image -%}
                  <a href="{{ item.url }}">
                    <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.image.alt | escape }}" width="100" height="100" loading="lazy">
                  </a>
                {%- endif -%}
              </div>
              <div class="cart-line__details">
                <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="cart-line__variant">{{ item.variant.title }}</p>
                {%- endunless -%}
                {%- if item.selling_plan_allocation -%}
                  <p class="cart-line__plan">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                {%- endif -%}
                <div class="cart-line__actions">
                  <div class="cart-qty" role="group" aria-label="{{ 'cart.quantity_for' | t: product: item.product.title }}">
                    <button type="button" class="cart-qty__btn" data-cart-qty-minus aria-label="{{ 'accessibility.decrease_qty' | t }}"{% if item.quantity <= 1 %} disabled{% endif %}>
                      <svg width="12" height="2" viewBox="0 0 12 2" fill="none" aria-hidden="true"><path d="M1 1h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    </button>
                    <label class="visually-hidden" for="Quantity-{{ forloop.index }}">{{ 'cart.quantity' | t }}</label>
                    <input id="Quantity-{{ forloop.index }}" type="number" inputmode="numeric" name="updates[]" value="{{ item.quantity }}" min="0" class="cart-qty__input" aria-label="{{ 'cart.quantity_for' | t: product: item.product.title }}" data-cart-qty-input>
                    <button type="button" class="cart-qty__btn" data-cart-qty-plus aria-label="{{ 'accessibility.increase_qty' | t }}">
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    </button>
                  </div>
                  <a href="{{ routes.cart_change_url }}?line={{ item.key }}&amp;quantity=0" class="cart-line__remove" data-cart-remove>{{ 'cart.remove' | t }}</a>
                </div>
              </div>
              <p class="cart-line__total">{{ item.final_line_price | money }}</p>
            </div>
          {%- endfor -%}
        </div>

        <div class="cart-page__footer">
          <p class="cart-page__total">{{ 'cart.subtotal' | t }} {{ cart.total_price | money }}</p>
          <div class="cart-page__delivery-card">
            <p class="cart-page__delivery-title">{{ 'cart.delivery_method' | t }}</p>
            <p class="cart-page__delivery-value">{{ 'cart.delivery_value' | t }}</p>
            <p class="body-reduced text-muted">{{ 'cart.delivery_note' | t }}</p>
          </div>

          <div class="cart-page__checkout-buttons">
            <button type="submit" name="checkout" class="btn-apple-primary btn-block cart-page__checkout-btn" data-cart-sticky-anchor>{{ 'cart.checkout' | t }}</button>
            <div class="cart-page__dynamic-checkout">
              {{ form | payment_button }}
            </div>
          </div>

          <div class="cart-page__actions">
            <button type="submit" name="update" class="btn-apple-secondary">{{ 'cart.update' | t }}</button>
            <a href="{{ routes.root_url }}" class="link-apple-blue">{{ 'cart.continue_shopping' | t }}</a>
          </div>

          <div class="cart-page__trust">
            <svg width="12" height="14" viewBox="0 0 12 14" fill="none" aria-hidden="true"><rect x="1" y="6" width="10" height="7" rx="1" stroke="currentColor"/><path d="M3 6V4a3 3 0 0 1 6 0v2" stroke="currentColor"/></svg>
            <span>{{ 'cart.checkout_trust' | t }}</span>
          </div>
        </div>

        {%- comment -%}
          Mobile/tablet: keeps Checkout reachable while the shopper scrolls the lines.
          cart-page.js shows this bar only while the in-page Checkout button is still
          below the viewport, so the two never share the screen and nothing is covered
          once the summary is in view. Without JS it stays hidden.
        {%- endcomment -%}
        <aside class="cart-sticky" aria-label="{{ 'cart.checkout' | t }}" data-cart-sticky hidden>
          <div class="cart-sticky__inner">
            <p class="cart-sticky__price">
              <span class="cart-sticky__label">{{ 'cart.subtotal' | t }}</span>
              <strong>{{ cart.total_price | money }}</strong>
            </p>
            <button type="submit" name="checkout" class="btn-apple-primary cart-sticky__btn">{{ 'cart.checkout' | t }}</button>
          </div>
        </aside>
      {% endform %}
    {%- else -%}
      <p class="body-elevated text-muted cart-page__empty-msg">{{ 'cart.empty' | t }}</p>
      <p class="body-reduced text-muted cart-page__empty-note">{{ 'cart.empty_configure_note' | t }}</p>
      <a href="{{ configure_url }}" class="btn-apple-primary">{{ 'cart.empty_configure_cta' | t }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
