## {{ 'llms_page.faq_heading' | t }}

{%- for i in (1..6) -%}
  {%- liquid
    assign q_key = 'faq.q' | append: i
    assign a_key = 'faq.a' | append: i
    assign q_text = q_key | t
    assign a_text = a_key | t
  -%}
  {%- assign faq_missing = false -%}
  {%- if q_text contains 'ranslation missing' or a_text contains 'ranslation missing' -%}
    {%- assign faq_missing = true -%}
  {%- endif -%}
  {%- if q_text != blank and a_text != blank and faq_missing == false %}
- **{{ q_text }}** {{ a_text }}
  {%- endif -%}
{%- endfor %}

