{% comment %} Plain-text page for AI crawlers (Page handle "llms", template page.llms, layout: none). Answer-first: entity, category, audience, proof, then links. {% endcomment %}
{%- liquid
  capture configure_buy_url
    render 'configure-url', plan: 'buy'
  endcapture
  assign configure_buy_url = configure_buy_url | strip
  assign locale_root = request.locale.iso_code | split: '-' | first | downcase
  assign llms_short_url = 'llms.txt' | asset_url | prepend: 'https:'
  assign llms_full_url = 'llms-full.txt' | asset_url | prepend: 'https:'
  assign ai_sitemap_url = 'sitemap-ai.xml' | asset_url | prepend: 'https:'
  if locale_root != 'en'
    assign llms_short_local = 'llms.' | append: locale_root | append: '.txt' | asset_url | prepend: 'https:'
    assign llms_full_local = 'llms-full.' | append: locale_root | append: '.txt' | asset_url | prepend: 'https:'
  endif
  assign buy_product = settings.product_buy
  assign reviewed_on = settings.seo_last_reviewed | strip
  assign page_keys = 'features,how-it-works,the-kevin-app,pricing,about-kevin,press,careers,setup-guide,contact' | split: ','
  assign md_files = 'kevin.md,kevin-product.md,kevin-specs.md,kevin-faq.md,kevin-company.md' | split: ','
-%}
