{%- comment -%}
  Custom robots.txt (replaces Shopify's default entirely, so the standard
  Shopify disallows are restated here). Everything else, including the AI/LLM
  summary files and knowledge Markdown, is crawlable by every user agent.
{%- endcomment -%}
User-agent: *
Disallow: /admin
Disallow: /cart
Disallow: /orders
Disallow: /checkout
Disallow: /checkouts/
Disallow: /account
Disallow: /carts
Disallow: /search
Disallow: /apple-app-site-association
Disallow: /.well-known/shopify/monorail
Disallow: /*preview_theme_id*
Disallow: /*preview_script_id*
Disallow: /*?*variant=
Disallow: /collections/*sort_by*
Disallow: /*/collections/*sort_by*
Disallow: /collections/*+*
Disallow: /collections/*%2B*
Disallow: /collections/*%2b*
Disallow: /*/collections/*+*
Disallow: /*/collections/*%2B*
Disallow: /*/collections/*%2b*
Disallow: /*?view=configure
Disallow: /*&view=configure
Allow: /pages/configure
Allow: /pages/llms
Allow: /pages/sitemap
Allow: /cdn/shop/t/*/assets/llms.txt
Allow: /cdn/shop/t/*/assets/llms-full.txt
Allow: /cdn/shop/t/*/assets/llms.*.txt
Allow: /cdn/shop/t/*/assets/llms-full.*.txt
Allow: /cdn/shop/t/*/assets/kevin*.md
Allow: /cdn/shop/t/*/assets/sitemap-ai.xml

{%- liquid
  # The shop domain renders empty in the robots.txt context; Shopify's own sitemap entry carries the primary domain.
  assign shopify_sitemap_url = ''
  for group in robots.default_groups
    if group.sitemap != blank
      assign shopify_sitemap_url = group.sitemap.value
    endif
  endfor
  assign store_origin = shopify_sitemap_url | remove: '/sitemap.xml'
%}
# Sitemaps (Shopify native, per locale + AI/AEO/GEO index with llms.txt and llms-full.txt URLs)
Sitemap: {{ shopify_sitemap_url }}
Sitemap: https:{{ 'sitemap-ai.xml' | asset_url }}

# LLM discovery (short file links to full file in content)
# Short:     https:{{ 'llms.txt' | asset_url }}
# Full:      https:{{ 'llms-full.txt' | asset_url }}
# Knowledge: https:{{ 'kevin.md' | asset_url }}
# Page:      {{ store_origin }}/pages/llms
