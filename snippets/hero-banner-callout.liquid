{%- comment -%}
  Hero spec chip — eyebrow + title; body for screen readers. Pass: modifier, eyebrow, title, body, block_attributes
{%- endcomment -%}
<li class="hero-spec-chip hero-spec-chip--{{ modifier }}"{{ block_attributes }}>
  <div class="hero-spec-chip__inner">
    {%- if eyebrow != blank -%}
      <span class="hero-spec-chip__eyebrow">{{ eyebrow | escape }}</span>
    {%- endif -%}
    {%- if title != blank -%}
      <strong class="hero-spec-chip__title">{{ title | escape }}</strong>
    {%- endif -%}
    {%- if body != blank -%}
      <span class="hero-spec-chip__body">{{ body | escape }}</span>
    {%- endif -%}
  </div>
</li>
