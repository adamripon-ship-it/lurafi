{%- assign lurafi_ship_countries_csv = 'AT,BE,BG,HR,CY,CZ,DE,DK,EE,FI,FR,GR,HU,IE,IT,LV,LT,LU,MT,NL,PL,PT,RO,SK,SI,ES,SE,NO,IS,CH,LI' -%}
{%- assign lurafi_ship_countries = lurafi_ship_countries_csv | split: ',' -%}
{%- comment -%}
  Offer list for a product's variants (schema.org Offer[]), shared by the home page
  Product and the product-page Product so both describe the same entity.
  Params: product (Product), org_id (String, Organization @id), is_main (Boolean:
  the Kevin device — adds warranty + specs-grade return/shipping details).
  Checkout markets mirror config/entity.json organization.checkoutMarkets.
{%- endcomment -%}
{%- liquid
  assign offer_currency = cart.currency.iso_code | default: shop.currency
  assign price_valid_until = 'now' | date: '%Y' | plus: 1 | append: '-12-31'
  assign product_abs_url = shop.url | append: product.url
-%}
"offers": [
{%- for v in product.variants -%}
  {
    "@type": "Offer",
    "url": {{ product_abs_url | append: '?variant=' | append: v.id | json }},
    "sku": {{ v.sku | default: product.handle | json }},
    {%- if v.barcode != blank %}
    "gtin": {{ v.barcode | json }},
    {%- endif %}
    {%- if v.title != 'Default Title' %}
    "name": {{ product.title | append: ' — ' | append: v.title | json }},
    {%- endif %}
    "priceCurrency": {{ offer_currency | json }},
    "price": {{ v.price | divided_by: 100.0 | json }},
    "priceValidUntil": {{ price_valid_until | json }},
    "availability": {% if v.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %},
    "itemCondition": "https://schema.org/NewCondition",
    "seller": { "@id": {{ org_id | json }} },
    {%- if is_main %}
    "warranty": {
      "@type": "WarrantyPromise",
      "durationOfWarranty": { "@type": "QuantitativeValue", "value": 3, "unitCode": "ANN" }
    },
    {%- endif %}
    "shippingDetails": {
      "@type": "OfferShippingDetails",
      "shippingRate": { "@type": "MonetaryAmount", "value": 0, "currency": {{ offer_currency | json }} },
      "shippingDestination": [
        {%- for cc in lurafi_ship_countries %}
        { "@type": "DefinedRegion", "addressCountry": {{ cc | json }} }{% unless forloop.last %},{% endunless %}
        {%- endfor %}
      ]
    },
    "hasMerchantReturnPolicy": {
      "@type": "MerchantReturnPolicy",
      "applicableCountry": {{ lurafi_ship_countries | json }},
      "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
      "merchantReturnDays": 30,
      "returnMethod": "https://schema.org/ReturnByMail"
    }
  }{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
