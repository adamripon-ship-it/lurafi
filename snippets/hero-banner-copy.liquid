{%- comment -%}
  Hero copy: headline, lede, primary CTA (no eyebrow, no trust strip).
{%- endcomment -%}
<div class="hero-banner__copy">
  <h1 class="hero-banner__headline headline-hero" id="HeroHeading">
    {{ headline }}
  </h1>

  {%- if lede != blank -%}
    <p class="hero-banner__lede body-elevated">{{ lede }}</p>
  {%- endif -%}

  {%- if cta_primary_label != blank -%}
    <div class="hero-banner__actions">
      <a href="{{ cta_primary_url }}" class="hero-banner__cta hero-banner__cta--primary">
        {{ cta_primary_label | replace: '&amp;', '&' | replace: '&#39;', "'" | replace: '&#x27;', "'" | replace: '&quot;', '"' | replace: '&#34;', '"' | escape }}
      </a>
      <a href="#product" class="hero-banner__cta ke-hero-explore">{{ 'explorer.load' | t }}</a>
    </div>
  {%- endif -%}

  {% render 'hero-press-logos' %}
</div>
